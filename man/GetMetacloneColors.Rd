\name{GetMetacloneColors}
\alias{GetMetacloneColors}
\title{Create a Metaclone color palette}
\usage{
GetMetacloneColors(n, cluster_names)
}
\arguments{
  \item{n}{Number of Metaclone clusters.}
  \item{cluster_names}{Character vector used to name the returned colors.}
}
\value{A named character vector of hexadecimal colors.}
\description{
Returns a high-contrast preset palette for up to 18 clusters and an
interpolated palette for larger cluster sets.
}

